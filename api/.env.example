# Path to Outplayed media directory (contains game subfolders with .mp4 files)
OUTPLAYED_MEDIA_DIR=C:\Users\YourName\Videos\Outplayed

# Workspace directory for output files (clips, renders)
WORKSPACE_DIR=C:\Users\YourName\Videos\ai_video_editor_output
# Per-game corrections (<game>_examples.jsonl). Default: <WORKSPACE_DIR>/game_hints.
# GAME_HINTS_DIR=
# Jev audit log (jev-<date>.jsonl). Default: <WORKSPACE_DIR>/decisions.
# DECISIONS_LOG_DIR=

# Path to ffmpeg binary (optional, defaults to "ffmpeg" assuming it's in PATH)
FFMPEG_PATH=ffmpeg

# --- Phase 2: AI analyzer ---
ANTHROPIC_API_KEY=sk-ant-...
RANKER_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_RANK_CALLS=25
# Dollar ledger: per-asset spend cap (USD) across ranker, VLM and paraphrase calls.
# COST_CAP_PER_ASSET_USD=2.0
# Long-form story video (story-render): review budget outside the asset cap,
# game-audio level under the mic, mic loudness normalisation, title card length.
# STORY_BUDGET_USD=5.0
# STORY_GAME_AUDIO_VOLUME=0.35
# STORY_MIC_LOUDNORM=true
# STORY_CARD_SECONDS=2.5

# --- Content direction: owner mic, HP reader, beat sync ---
# Owner mic track (POST /api/v1/assets/{id}/transcribe-mic). Picked by override,
# then stream title/handler label, then speech activity; else none (fail closed).
# The override is the audio-relative index (0:a:N) and is only used when the
# file has >= 2 audio streams and N is in range. On this Outplayed profile the
# mic is the unlabelled audio stream 2.
# MIC_STREAM_OVERRIDE=2
# Speech-activity pick: the winner needs at least this fraction of active 20 ms
# frames (level independent: each stream is normalised to its own loud frames)
# and 1.5x the runner-up.
# MIC_MIN_ACTIVITY=0.05
# HP-bar reader: both false = off; SHADOW logs trade/escape events to
# WORKSPACE/hp_shadow/<asset>.json without candidates; ENABLED adds candidates.
# HP_READER_SHADOW=false
# HP_READER_ENABLED=false
# HP_READER_STEP_S=1.5
# Shorts beat sync default (the compile param still decides per render).
# SHORTS_BEAT_SYNC_ENABLED=false
# SHORTS_BEAT_SYNC_STRATEGY was removed (nothing read it); delete it from .env.
# USD per million tokens [input, output], as JSON. A model missing here is
# costed at the highest listed price (and logged) so the cap still trips.
# MODEL_PRICES_USD_PER_MTOK={"claude-sonnet-4-6": [3.0, 15.0], "claude-haiku-4-5": [1.0, 5.0]}
# Digest voice paraphrase (one short call per clip with speech).
# PARAPHRASE_MODEL=claude-haiku-4-5
# PARAPHRASE_MAX_CALLS=200

# TypeSafe Jev (typed decisions: format classification + include/exclude
# pre-filter). Key from https://console.typesafe.ai. Blank = free local
# rules backend. DECISIONS_BACKEND=auto|jev|haiku|rules (auto never Haiku).
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_MAX_CALLS=2000

# Grok Bot outbound events (job.done, heartbeat) POSTed as JSON with a
# Bearer key. Blank url or key = webhook disabled (events only logged).
GROKBOT_WEBHOOK_URL=
GROKBOT_WEBHOOK_KEY=
GROKBOT_MAX_EVENTS_PER_HOUR=120
GROKBOT_TIMEOUT_SECONDS=10.0

# Grok Bot team Google Drive folder (optional; blank = disabled). Create an
# OAuth "Desktop app" client, set id/secret, run `uv run drive-auth` once,
# and paste the printed refresh token and folder id (FOLDER_ID is printed by
# drive-auth, which creates the root folder itself; do not make it by hand).
GROKBOT_DRIVE_CLIENT_ID=
GROKBOT_DRIVE_CLIENT_SECRET=
GROKBOT_DRIVE_REFRESH_TOKEN=
GROKBOT_DRIVE_FOLDER_ID=
GROKBOT_DRIVE_PREVIEW_RETENTION_DAYS=7

# Riot API source for League kill events (optional; free dev key at
# https://developer.riotgames.com). Leave blank to disable this source.
RIOT_API_KEY=
RIOT_ID=YourName#NA1
RIOT_REGION=americas
# Nudge if Riot clips land consistently early/late (seconds, +/-).
RIOT_SYNC_OFFSET_SECONDS=0.0
# IANA timezone of recording filenames' local timestamps (DST-aware),
# used to correlate to Riot's UTC match times.
RECORDING_TIMEZONE=America/Chicago

# Langfuse tracing (free account at https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Analyzer tuning knobs (optional, sensible defaults in config.py)
ANALYZE_MAX_CANDIDATES=15
ANALYZE_PEAK_THRESHOLD=0.6
ANALYZE_WINDOW_PADDING=4.0
ANALYZE_SCORE_THRESHOLD=0.5

# Local Whisper STT (private, $0). cpu is reliable; set cuda only if
# the CUDA runtime is installed. base=fast; small/medium=better/slower.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Video encoder for /edit/compile (per-clip re-encode) and shorts rendering
# (FFMPEG_VIDEO_CODEC/_OPTS now drive shorts too). libx264 is the
# portable CPU default. Uncomment for NVIDIA GPU encode (~2-3x faster)
# — requires NVIDIA driver >= 570 (NVENC API 13.0).
# FFMPEG_VIDEO_CODEC=h264_nvenc
# FFMPEG_VIDEO_CODEC_OPTS=-preset p4 -cq 23 -rc vbr

# After zoom crop, scale to height 1080 (lanczos) instead of fixed 2x.
# Default off = legacy scale=iw*2:ih*2. Opt in so non-2.0 zoom factors
# stay 1080p and burned-in captions keep their intended size.
# ZOOM_SCALE_TO_1080P_ENABLED=false

# Highlight clip window around an exact event (Riot kill): seconds of
# lead-up and follow-through. Widen for more context.
HIGHLIGHT_PRE_SECONDS=7.5
HIGHLIGHT_POST_SECONDS=7.5
# Riot candidates with fight bounds cut the whole fight (one clip per
# fight). false = per-event anchor window, no same-fight merging.
# FIGHT_WINDOWS_ENABLED=true

# Grok Bot local runner. Leave the repo dir commented out unless set.
# GROKBOT_QUEUE_REPO_DIR=C:/path/to/queue-repo
GROKBOT_API_BASE_URL=http://127.0.0.1:8000
GROKBOT_RUNNER_POLL_SECONDS=60
GROKBOT_HEARTBEAT_SECONDS=300
GROKBOT_QUEUE_DEPTH_CAP=10
GROKBOT_EXECUTE_PLANS=false
GROKBOT_RECORD_VERDICTS=false

# One shared SQLite database for every checkout (absolute path). Default is
# cwd-relative, which gives each checkout its own empty database.
DATABASE_PATH=C:/path/to/ai-video-editor/api/ai_video_editor.db

# Per-clip edit aspect "9:16_hud" (HUD-preserving vertical). Default off —
# when false, aspect=9:16_hud is rejected with 400. Set true to enable.
# HUD_ASPECT_ENABLED=false

# Montage title burn-in opt-out. Default off = titles always burned. When
# true, the per-call `burn_title` parameter is honored (False = no title).
# MONTAGE_TITLE_OPTIONAL=false

# Caption fontsize scaling. Default off = fontsize used as-is for backward
# compatibility. When true, fontsize scales relative to output height
# (1080px reference) and text wraps/clamps to fit the frame.
# CAPTION_FONTSIZE_SCALE_ENABLED=false

# Play confirmer backend (league understanding). Empty = follow VLM_BACKEND
# (anthropic -> PLAY_CONFIRM_MODEL, Sonnet). `gemini` = Google AI Studio key
# (free tier works); `openrouter` = OpenRouter key (e.g. Qwen3-VL).
PLAY_CONFIRM_BACKEND=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-vl-30b-a3b-instruct

# Cloud VOD backups (Supabase Storage, S3-compatible). Inert until all set.
# Keys: Supabase dashboard -> Project Settings -> Storage -> S3 Access Keys.
SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-west-2
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
# STORAGE_MAX_TOTAL_GB=100
